# Скопируй в .env и заполни. .env не коммитится (см. .gitignore).
# В продакшене этот файл создаётся автоматически шагом деплоя GitHub Actions
# из секрета TELEGRAM_BOT_TOKEN — см. docs/DEPLOYMENT.md.

NODE_ENV=development
PORT=3000

# Токен бота от @BotFather. Нужен, чтобы проверять подпись Telegram.WebApp.initData
# и не пускать чужие запросы к /api/scenarios. Без него сервер в production
# откажется обслуживать API (в development — работает в открытом dev-режиме).
TELEGRAM_BOT_TOKEN=

# Куда на диске складывать сохранённые сценарии. По умолчанию — server/data/scenarios.
# В продакшене указывается путь ВНЕ каталога с кодом приложения, чтобы деплой
# (rsync --delete) не стирал сохранённые данные при каждом обновлении.
SCENARIOS_DIR=./data/scenarios

# Куда складывать расписания напоминаний (по файлу на пользователя Telegram).
# Как и сценарии, обязано лежать ВНЕ каталога с кодом: rsync --delete при
# деплое стирает всё, что внутри app/.
SCHEDULES_DIR=./data/schedules

# Куда складывать файлы отчётов по задачам (снимки экрана, PDF и т.п.).
# Внутри — каталог на пользователя, названный случайным scope: ссылка на файл
# должна открываться браузером напрямую, без заголовка с подписью Telegram,
# поэтому знание ссылки и есть право на чтение. Как и остальное, лежит ВНЕ
# каталога с кодом.
REPORTS_DIR=./data/reports
