# Скопируй в .env и заполни. .env не коммитится (см. .gitignore).
# В продакшене этот файл создаётся автоматически шагом деплоя GitHub Actions
# из секрета TELEGRAM_BOT_TOKEN — см. docs/DEPLOYMENT.md.

NODE_ENV=development
PORT=3000

# Токен бота от @BotFather. Нужен, чтобы проверять подпись Telegram.WebApp.initData
# и не пускать чужие запросы к /api/scenarios. Без него сервер в production
# откажется обслуживать API (в development — работает в открытом dev-режиме).
TELEGRAM_BOT_TOKEN=

# Куда на диске складывать сохранённые сценарии. По умолчанию — server/data/scenarios.
# В продакшене указывается путь ВНЕ каталога с кодом приложения, чтобы деплой
# (rsync --delete) не стирал сохранённые данные при каждом обновлении.
SCENARIOS_DIR=./data/scenarios

# Куда складывать расписания напоминаний (по файлу на пользователя Telegram).
# Как и сценарии, обязано лежать ВНЕ каталога с кодом: rsync --delete при
# деплое стирает всё, что внутри app/.
SCHEDULES_DIR=./data/schedules

# Куда складывать файлы отчётов по задачам (снимки экрана, PDF и т.п.).
# Внутри — каталог на пользователя, названный случайным scope: ссылка на файл
# должна открываться браузером напрямую, без заголовка с подписью Telegram,
# поэтому знание ссылки и есть право на чтение. Как и остальное, лежит ВНЕ
# каталога с кодом.
REPORTS_DIR=./data/reports

# Люди и роли: кто владелец, какие есть роли, кто в какой.
ORG_DIR=./data/org

# Общая модель — одна на всех, принадлежит владельцу. Остальные получают
# из неё только свои задачи (см. lib/workspaceStore.js).
WORKSPACE_DIR=./data/workspace

# Шаги сдачи в чате бота (на каком вопросе человек, что уже приложил):
# один файл на всех, чтобы перезапуск не сбрасывал сдачу посреди вопроса.
# По умолчанию — bot-steps.json рядом с моделью (в WORKSPACE_DIR), задавать
# отдельно не нужно; свой путь — сюда.
#BOT_STEPS_FILE=./data/workspace/bot-steps.json

# Владелец: единственный, кто видит всё и может приглашать людей. Если не
# задан, владельцем становится первый, кто открыл приложение, — на публичном
# адресе так делать не стоит. Свой номер можно узнать, отправив боту /id.
OWNER_TELEGRAM_ID=

# Встречи и комнаты созвонов.
CALLS_DIR=./data/calls

# Память помощника: по файлу на пользователя. Как и остальное — ВНЕ каталога
# с кодом, иначе деплой сотрёт её при обновлении.
MEMORY_DIR=./data/memory

# Чем думает помощник. Задаётся владельцем из приложения («Инструменты» →
# «Помощник»), сервер кладёт значения сюда сам. Провайдер — openai, claude
# или hf; модель пустая — подставится умолчание (см. lib/aiProviders.js).
# Ключ наружу не отдаётся никогда, только «есть/нет».
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_API_KEY=

# Адрес, по которому приложение открывается снаружи. Из него собирается
# запасная ссылка на звонок (https://<домен>/call?call=<id>), когда отдельное
# мини-приложение звонка не заведено. В продакшене подставляется деплоем.
PUBLIC_URL=

# TURN-сервер для звонков. STUN хватает в большинстве сетей, но если оба
# собеседника за строгим NAT, без TURN соединение не установится вовсе.
# Публичного бесплатного TURN не бывает — это либо свой coturn, либо услуга.
TURN_URL=
TURN_USER=
TURN_PASS=

# TURN на этом же сервере (coturn): деплой рождает секрет сам и настраивает
# coturn по нему. TURN_HOST — домен приложения.
TURN_SECRET=
TURN_HOST=

# Короткое имя ОТДЕЛЬНОГО мини-приложения звонка: @BotFather → /newapp, адрес
# приложения https://<домен>/call, короткое имя, например call. Через Bot API
# такое приложение не завести — метода нет, только руками. Проще всего задать
# его не здесь, а из чата с ботом: «/callapp call» — сервер сам положит имя
# в .env, а деплой его сохранит.
# Пусто — ссылка на звонок ведёт на страницу https://<домен>/call. Она тоже
# открывается у всех, но обычной страницей: камеру и микрофон Telegram надёжно
# даёт только мини-приложению. На главное приложение модели ссылка на звонок
# не ведёт никогда — звонок отдельно от модели.
TELEGRAM_CALL_APP=
